# Copy to .env.local for development, and set the same values in the deploy
# workflow for a build that goes live. This is a static export, so both are read
# at BUILD time and baked into the HTML — changing them means rebuilding.

# Where the WordPress plugin serves the scan API.
# Leave this unset and the tool runs on sample data with a "preview mode" banner.
#
#   Bluehost, WordPress at /blog/:  https://thallodigital.com/blog/wp-json/thallo/v1
#   WordPress on its own subdomain: https://cms.thallodigital.com/wp-json/thallo/v1
#   Local WordPress:                http://localhost:8080/wp-json/thallo/v1
#
# Anything other than same-origin also needs the site's origin added to
# "Allowed origins" on the plugin's settings screen.
NEXT_PUBLIC_SCAN_API=

# Not normally set by hand. `next.config.ts` derives it from DEPLOY_TARGET and
# exports it, so that basePath and every hand-written href agree:
#
#   DEPLOY_TARGET=bluehost  →  ''                (site at the domain root)
#   anything else           →  '/thallo-digital' (GitHub Pages project path)
#
# NEXT_PUBLIC_BASE_PATH=
